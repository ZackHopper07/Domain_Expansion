# Copy to .env and edit. Only VITE_ variables reach the browser,
# so never put registrar API keys here; they belong in the FastAPI backend.

# true = sample demo data, false = call the FastAPI backend
VITE_USE_MOCK=true

# Where the FastAPI backend runs (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:8000
