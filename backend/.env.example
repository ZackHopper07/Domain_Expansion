# Copy to backend/.env and edit. Real environment variables win over this file.
# Registrar API keys will go here too; never commit backend/.env.

# demo = made-up availability, rdap = real lookups against registry RDAP servers
AVAILABILITY_SOURCE=demo

# Browser origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Seconds to wait for one RDAP server before reporting "unknown"
RDAP_TIMEOUT=5
