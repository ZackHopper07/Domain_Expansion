# Copy to backend/.env for running the API without Docker.
# backend/.env is git-ignored: real passwords and registrar API keys go there, never in the frontend.

# PostgreSQL started by `docker compose up db`
DATABASE_URL=postgresql+asyncpg://pricemydomain:pricemydomain@localhost:5432/pricemydomain

# No database yet? Use a local file instead (fine for trying things out):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Frontend addresses allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5180

# Availability: "rdap" = real lookups with the official domain registries, "demo" = sample data
AVAILABILITY=rdap

# Prices: "demo" = sample prices until real registrar APIs are connected
PROVIDERS=demo

# Seconds to wait for each registrar before reporting it as failed
PROVIDER_TIMEOUT_SECONDS=5
